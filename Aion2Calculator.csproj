<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AION2-Damage-Calculator</AssemblyName>
    <ApplicationTitle>AION 2 Damage Calculator</ApplicationTitle>
    <Version>1.0.2</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" />
    <EmbeddedResource Include="index.html" LogicalName="index.html" />
    <EmbeddedResource Include="style.css" LogicalName="style.css" />
    <EmbeddedResource Include="i18n.js" LogicalName="i18n.js" />
    <EmbeddedResource Include="calculator.js" LogicalName="calculator.js" />
    <EmbeddedResource Include="numeric-input.js" LogicalName="numeric-input.js" />
    <EmbeddedResource Include="recommendations.js" LogicalName="recommendations.js" />
    <EmbeddedResource Include="icons.js" LogicalName="icons.js" />
    <EmbeddedResource Include="profile-ui.js" LogicalName="profile-ui.js" />
    <EmbeddedResource Include="ai-tips.js" LogicalName="ai-tips.js" />
    <EmbeddedResource Include="attribute-trees.js" LogicalName="attribute-trees.js" />
    <EmbeddedResource Include="ai-worker.bundle.js" LogicalName="ai-worker.bundle.js" />
    <EmbeddedResource Include="assets/ai/*" LogicalName="assets/ai/%(Filename)%(Extension)" />
    <EmbeddedResource Include="assets/ai/models/external/onnx-community/Qwen3-0.6B-ONNX/*.json" LogicalName="assets/ai/models/external/onnx-community/Qwen3-0.6B-ONNX/%(Filename)%(Extension)" />
    <EmbeddedResource Include="assets/ai/models/external/onnx-community/Qwen3-0.6B-ONNX/onnx/model_quantized.onnx" LogicalName="assets/ai/models/external/onnx-community/Qwen3-0.6B-ONNX/onnx/model_quantized.onnx" />
    <EmbeddedResource Include="assets/ai/models/external/onnx-community/Qwen3-0.6B-ONNX/onnx/model_quantized.onnx_data" LogicalName="assets/ai/models/external/onnx-community/Qwen3-0.6B-ONNX/onnx/model_quantized.onnx_data" />
    <EmbeddedResource Include="assets/classes/*.webp" LogicalName="assets/classes/%(Filename)%(Extension)" />
    <EmbeddedResource Include="matchups.js" LogicalName="matchups.js" />
    <EmbeddedResource Include="boss-data.js" LogicalName="boss-data.js" />
    <EmbeddedResource Include="mob-data.js" LogicalName="mob-data.js" />
    <EmbeddedResource Include="bosses.js" LogicalName="bosses.js" />
    <EmbeddedResource Include="stat-tooltips.js" LogicalName="stat-tooltips.js" />
    <EmbeddedResource Include="renderer.js" LogicalName="renderer.js" />
    <EmbeddedResource Include="characters.js" LogicalName="characters.js" />
  </ItemGroup>
  <Target Name="RemoveUnusedWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
  <Target Name="CheckLocalModel" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('assets/ai/models/external/onnx-community/Qwen3-0.6B-ONNX/onnx/model_quantized.onnx')" Text="Run npm ci and npm run build:ai to bundle Qwen3-0.6B q8 before publishing." />
    <Error Condition="!Exists('assets/ai/models/external/onnx-community/Qwen3-0.6B-ONNX/onnx/model_quantized.onnx_data')" Text="Run npm ci and npm run build:ai to bundle Qwen3-0.6B q8 before publishing." />
  </Target>
</Project>
